<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Custom ScrollBar Style -->
    <Style x:Key="QuestScrollBarButtonUpStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Background" Value="{StaticResource img-guide-button-up}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource img-guide-button-up-hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource img-guide-button-up-pressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="QuestScrollBarButtonDownStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Background" Value="{StaticResource img-guide-button-down}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource img-guide-button-down-hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource img-guide-button-down-pressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="QuestScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="Background" Value="{StaticResource img-guide-scroll-background}"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <!-- Main Scroll Background -->
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <!-- Up Button -->
                            <RowDefinition Height="Auto"/>
                            <!-- Thumb Track -->
                            <RowDefinition Height="*"/>
                            <!-- Down Button -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Scroll Background -->
                        <Border Grid.Row="0" Grid.RowSpan="3" Background="{TemplateBinding Background}"
                                Width="14"
                                Margin="0 2 0 0"/>

                        <!-- Up Button -->
                        <RepeatButton Grid.Row="0"
                                      Command="ScrollBar.LineUpCommand"
                                      Style="{StaticResource QuestScrollBarButtonUpStyle}"
                                      Height="16"/>

                        <!-- Thumb Track -->
                        <Track Grid.Row="1"
                               x:Name="PART_Track"
                               IsDirectionReversed="True"
                               ViewportSize="NaN">
                            <Track.Thumb>
                                <!-- Scroll Thumb -->
                                <Thumb Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBackground"
                                                    Background="{StaticResource img-guide-button-thumb}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBackground" Property="Background"  Value="{StaticResource img-guide-button-thumb-hover}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBackground" Property="Background"  Value="{StaticResource img-guide-button-thumb-pressed}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>

                        <!-- Down Button -->
                        <RepeatButton Grid.Row="2"
                                      Command="ScrollBar.LineDownCommand"
                                      Style="{StaticResource QuestScrollBarButtonDownStyle}"
                                      Height="16"
                                      Margin="0 0 0 19"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom ScrollViewer Template that applies the ScrollBar Style -->
    <Style x:Key="QuestScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Content Presenter (Holds whatever is inside your ScrollViewer) -->
                        <ScrollContentPresenter Grid.Column="0"/>

                        <!-- Vertical ScrollBar -->
                        <ScrollBar Grid.Column="1"
                                   x:Name="PART_VerticalScrollBar"
                                   Style="{StaticResource QuestScrollBarStyle}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>