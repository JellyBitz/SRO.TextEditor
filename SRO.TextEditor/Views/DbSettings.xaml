<hc:Window x:Class="SRO.TextEditor.Views.DbSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:SRO.TextEditor"
        mc:Ignorable="d"
        Width="360" Height="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- Settings layout -->
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            
            <!-- Save / Cancel-->
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Connection -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Host : " Style="{StaticResource TextBlockBaseStyle}"
                       HorizontalAlignment="Right"/>
            <TextBox Grid.Column="1"
                     Style="{StaticResource TextBoxExtend}"
                     Text="{Binding Host}"
                     VerticalAlignment="Center"
                     hc:InfoElement.Placeholder=".\SQLEXPRESS"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Login : " Style="{StaticResource TextBlockBaseStyle}"
                       HorizontalAlignment="Right"/>
            <TextBox Grid.Column="1"
                     Style="{StaticResource TextBoxExtend}"
                     Text="{Binding Login}"
                     VerticalAlignment="Center"
                     hc:InfoElement.Placeholder="sa"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Password : " Style="{StaticResource TextBlockBaseStyle}"
                       HorizontalAlignment="Right"/>
            <hc:PasswordBox Grid.Column="1"
                            Style="{StaticResource PasswordBoxPlusBaseStyle}"
                            hc:InfoElement.Placeholder="*****"
                            ShowEyeButton="True"
                            VerticalAlignment="Center"
                            IsSafeEnabled="False"
                            UnsafePassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Database : " Style="{StaticResource TextBlockBaseStyle}"
                       HorizontalAlignment="Right"/>
            <TextBox Grid.Column="1"
                     Style="{StaticResource TextBoxExtend}"
                     Text="{Binding Database}"
                     VerticalAlignment="Center"
                     hc:InfoElement.Placeholder="SRO_TEXTDATA"/>
        </Grid>
        <!-- Save / Cancel -->
        <Grid Grid.Row="4"
              Margin="100 15 100 5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Style="{StaticResource ButtonPrimary}"
                    Content="Save"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Grid.Column="1"
                    Style="{StaticResource ButtonDefault}"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>
        
    </Grid>
</hc:Window>
